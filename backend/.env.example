# Server
PORT=4000
NODE_ENV=development

# Database (local Prisma runs should use localhost; Docker containers use the db service name)
DATABASE_URL="postgresql://renewcred:renewcred_dev_pw@localhost:5432/renewcred_cms?schema=public"

# Auth
JWT_ACCESS_SECRET=change_this_access_secret_before_deploying
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_before_deploying
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
